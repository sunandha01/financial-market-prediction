DATABASE_URL=postgresql://localhost:5432/market_predict

# Phase 8/10: the admin login. Put a long random string here in your own .env (never commit it).
# It is the value you type on the site's /login page and the X-Admin-Token header for POST /admin/*.
# Leave empty to disable every admin route. Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=
